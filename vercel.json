{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mcp.py": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/", "destination": "/docs/index.html" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/mcp/", "destination": "/api/mcp" },
    { "source": "/styles.css", "destination": "/docs/styles.css" },
    { "source": "/app.js", "destination": "/docs/app.js" },
    { "source": "/favicon.svg", "destination": "/docs/favicon.svg" },
    { "source": "/robots.txt", "destination": "/docs/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/docs/sitemap.xml" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(styles.css|app.js|favicon.svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/mcp",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
